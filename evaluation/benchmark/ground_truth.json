    "related_incident_ids": [
      "INC-019"
    ],
    "prior_occurrences": 3,
    "expected_occurrence_number": 4,
    "known_root_causes": {
      "INC-003": "Weekend order volume queued jobs and cached idempotency keys in Redis without eviction; by Monday's traffic ramp Redis hit its 2GB maxmemory limit with the default noeviction policy.",
      "INC-008": "The allkeys-lru eviction policy set after INC-003 slowed the OOM but idempotency keys from the order-retry-queue still have no TTL, so memory pressure builds back up over the weekend.",
      "INC-015": "Root-caused at last: the order-retry-queue's dead-letter keys were excluded from the TTL fix added in INC-008 due to a key-prefix mismatch (retry: vs order-retry:); those keys never expired."
    },
    "worked_fixes": {
      "restart_redis_and_set_eviction_policy": "eviction|maxmemory-policy|allkeys-lru|volatile-lru",
      "add_ttl_to_job_result_keys": "\\bttl\\b|expire|expiry|expiration",
      "fix_ttl_key_prefix_mismatch": "prefix|ttl.{0,50}(filter|mismatch|cover|miss|exclud)|(filter|mismatch|exclud).{0,50}ttl|dead-?letter"
    },
