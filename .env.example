# Copy to .env and fill in. Never commit .env.
# Hindsight Cloud credentials (required)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# Groq API key for LLM calls: briefings, chat, postmortems (required)
GROQ_API_KEY=

# LLM model overrides (optional, defaults: openai/gpt-oss-120b, qwen/qwen3.8-27b)
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACK=

# Timeouts in seconds (optional, defaults: HINDSIGHT_TIMEOUT=20, LLM_TIMEOUT=30)
HINDSIGHT_TIMEOUT=
LLM_TIMEOUT=

# Frontend origins for CORS: comma-separated list of origins (required in production)
FRONTEND_ORIGIN=
