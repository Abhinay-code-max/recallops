# Copy to .env and fill in. Never commit .env.
# Hindsight Cloud credentials (required)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

# Groq API key for LLM calls: briefings, chat, postmortems (required)
GROQ_API_KEY=

# LLM model overrides (optional, defaults: openai/gpt-oss-120b, qwen/qwen3.8-27b)
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACK=

# Timeouts in seconds (optional, defaults: HINDSIGHT_TIMEOUT=20, LLM_TIMEOUT=30)
HINDSIGHT_TIMEOUT=
LLM_TIMEOUT=

# Frontend origins for CORS: comma-separated list of origins (required in production)
FRONTEND_ORIGIN=

# Security (set on the server only, NEVER as VITE_* and never in the frontend)
# APP_ENV=production disables /docs, /redoc, /openapi.json and enables hardened mode.
APP_ENV=development
# Protects POST /seed and POST /reset (send as the X-RecallOps-Key header). Fail closed in production if unset.
ADMIN_API_KEY=
# Allows custom alerts on POST /alert (ADMIN_API_KEY also works). Predefined demo alerts need no key.
INGEST_API_KEY=
# Reverse-proxy hops that append to X-Forwarded-For (0 = use the socket peer). Used for per-IP rate limits.
RATE_LIMIT_TRUSTED_HOPS=0
# Cap on live incidents created through the public demo path.
MAX_LIVE_INCIDENTS=200
