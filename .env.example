# Copy to .env and fill in. Never commit .env.
# Confirm the exact Hindsight variable names against the Hindsight docs / client package.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=

GROQ_API_KEY=
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=qwen/qwen3.8-27b

# Timeouts (seconds). HINDSIGHT_TIMEOUT is the per-call ceiling for every Hindsight
# call (retain/recall/reflect) -- 20s because a real reflect() over the full incidents
# bank with a several-KB context measured ~19s in testing (GET /insights); recall/retain
# are much faster in practice and stay bounded by their own total-timeout wrappers
# (memory.RECALL_TOTAL_TIMEOUT_SECONDS, memory.REFLECT_TOTAL_TIMEOUT_SECONDS) regardless.
HINDSIGHT_TIMEOUT=20
LLM_TIMEOUT=30

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
